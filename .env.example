# Copia aquest fitxer a .env.local i omple'l. .env.local no es puja mai.

# Projecte Supabase (regió europea: Frankfurt o París)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clau pública (anon / publishable). Pot ser pública perquè l'RLS la conté.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Proveïdor d'autenticació: "password" (pla B) o "azure" (Entra ID)
NEXT_PUBLIC_AUTH_PROVIDER=password

# URL pública de l'app (per a la redirecció OAuth d'Entra ID)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# La clau service_role NO es fa servir enlloc d'aquesta app. No l'afegeixis.
